:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap');

body {
  background-color: #030405;
  margin: 0;
  padding: 20px;
}

tw-story {
  font-family: 'Courier Prime', monospace;
  font-size: 18px;
  line-height: 1.5;
  background-color: #0f1115;
  color: #d1d5db;
  
  width: 90%;
  max-width: 1100px;
  padding: 40px;
  margin: 20px auto;
  
  /* --- HARDWARE BEZEL & CRT CURVE EFFECT --- */
  border: 14px solid #1a1d24;
  border-radius: 35px;
  
  box-shadow: 
    0 0 30px rgba(0, 0, 0, 0.9),
    inset 0 0 50px rgba(0, 0, 0, 0.85),
    inset 0 0 15px rgba(255, 255, 255, 0.05);
    
  /* SUBTLER CRT GLOW */
  text-shadow: 0 0 1px rgba(209, 213, 219, 0.4), 0 0 3px rgba(56, 189, 248, 0.2);
  
  position: relative;
  overflow: hidden;
}

tw-story::before {
  content: " ";
  display: block;
  position: absolute;
  top: 0; left: 0; bottom: 0; right: 0;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%);
  background-size: 100% 4px;
  z-index: 2;
  pointer-events: none;
}

tw-link {
  color: #38bdf8;
  font-weight: bold;
  text-decoration: none;
  /* Subtler link glow */
  text-shadow: 0 0 2px rgba(56, 189, 248, 0.5);
}

tw-link:hover {
  color: #7dd3fc;
  text-decoration: underline;
  text-shadow: 0 0 4px rgba(125, 211, 252, 0.6);
}

tw-sidebar {
  display: none;
}