:: train2 {"position":"1400,1275","size":"100,100"}
<pre>
|announcementBox>[
+--------------------------------------------------+
| SYSTEM STANDBY: ENGINE OFF                       |
| PRESS [ START ENGINE ] TO BEGIN                  |
+--------------------------------------------------+
]
</pre>

### TRAIN CONTROLS
==================================================

{(set: $termStatus to "STANDBY")
(set: $termTrack to "LEFT")
(set: $engineStarted to false)
(set: $alarmActive to false)
(set: $commandInput to "")}

<pre>
|termDisplay>[
  `SYS_STATUS`: $termStatus
  `CURRENT_TRACK`: $termTrack
]
</pre>

==================================================

#### QUICK OVERRIDE CONTROLS

|startBtn>[(link-repeat: "[ START ENGINE ]")[{
  (if: not $engineStarted)[
    (set: $engineStarted to true)
    (set: $termStatus to "MOVING")
    (replace: ?termDisplay)[
  `SYS_STATUS`: $termStatus
  `CURRENT_TRACK`: $termTrack
    ]
    (replace: ?announcementBox)[
+--------------------------------------------------+
| ENGINE ONLINE: PROCEEDING DOWN MAIN LINE         |
+--------------------------------------------------+
    ]
    (replace: ?outputBox)[Engine started. Accelerating...]
    
    (live: 5s)[
      (stop:)
      (set: $alarmActive to true)
      (replace: ?announcementBox)[
+--------------------------------------------------+
| ! WARNING: PEOPLE DETECTED ON TRACKS !           |
| LEFT TRACK  : 5 MAINTENANCE WORKERS (EVACUATING) |
| RIGHT TRACK : 1 MAINTENANCE WORKER  (EVACUATING) |
+--------------------------------------------------+
      ]
      (replace: ?rightBtn)[(link-repeat: "DIVERT RIGHT >")[{
        (set: $termTrack to "RIGHT")
        (goto: "outcome_right")
      }]]
      (replace: ?outputBox)[WARNING: OBSTACLES DETECTED AHEAD! COLLISION IMMINENT IN 15 SECONDS!]
      (live: 15s)[
        (stop:)
        (goto: "outcome_left")
      ]
    ]
  ]
}]]

<br>

<span style="opacity:0.5;">[ < DIVERT LEFT (CURRENT TRACK) ]</span>

|rightBtn>[<span style="opacity:0.5;">[ DIVERT RIGHT > (LOCKED) ]</span>]

==================================================

<pre>
|outputBox>[Type 'help' for a list of available commands.]
</pre>

<br>
INPUT COMMAND:
(input: bind $commandInput, "=value")

(link-repeat: "EXECUTE")[{
  (set: $cleanCmd to (lowercase: $commandInput))
  
  (if: $cleanCmd is "help")[
    (replace: ?outputBox)[
AVAILABLE COMMANDS:
* ''help'' - Displays command list
* ''start'' - Start train engine
* ''right'' - Divert switch to Right Track (requires alarm active)
* ''stop'' - Emergency brake override (requires alarm active)
    ]
  ](else-if: $cleanCmd is "start")[
    (if: not $engineStarted)[
      (set: $engineStarted to true)
      (set: $termStatus to "MOVING")
      (replace: ?termDisplay)[
  `SYS_STATUS`: $termStatus
  `CURRENT_TRACK`: $termTrack
      ]
      (replace: ?announcementBox)[
+--------------------------------------------------+
| ENGINE ONLINE: PROCEEDING DOWN MAIN LINE         |
+--------------------------------------------------+
      ]
      (replace: ?outputBox)[Engine started. Accelerating...]
      
      (live: 5s)[
        (stop:)
        (set: $alarmActive to true)
        (replace: ?announcementBox)[
+--------------------------------------------------+
| ! WARNING: PEOPLE DETECTED ON TRACKS !           |
| LEFT TRACK  : 5 MAINTENANCE WORKERS (EVACUATING) |
| RIGHT TRACK : 1 MAINTENANCE WORKER  (EVACUATING) |
+--------------------------------------------------+
        ]
        (replace: ?rightBtn)[(link-repeat: "DIVERT RIGHT >")[{
          (set: $termTrack to "RIGHT")
          (goto: "outcome_right")
        }]]
        (replace: ?outputBox)[WARNING: OBSTACLES DETECTED AHEAD! COLLISION IMMINENT IN 7 SECONDS!]
        (live: 7s)[
          (stop:)
          (goto: "outcome_left")
        ]
      ]
    ](else:)[
      (replace: ?outputBox)[Engine is already running!]
    ]
  ](else-if: $cleanCmd is "left")[
    (replace: ?outputBox)[Train is already on the LEFT track.]
  ](else-if: $cleanCmd is "right")[
    (if: $alarmActive is true)[
      (set: $termTrack to "RIGHT")
      (goto: "outcome_right")
    ](else:)[
      (replace: ?outputBox)[Error: Track switches are locked or offline.]
    ]
  ](else-if: $cleanCmd is "stop")[
    (if: $alarmActive is true)[
      (set: $termStatus to "STOPPED")
      (goto: "outcome_stop")
    ](else:)[
      (replace: ?outputBox)[Error: Emergency override offline until hazards detected.]
    ]
  ](else:)[
    (replace: ?outputBox)[''$commandInput'' is not recognized. Type 'help' for options.]
  ]
}]


