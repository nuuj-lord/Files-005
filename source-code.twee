    <p><b style="color: #55ff55;">[10:16] $playerName:</b> It was CHENG LIANG.</p>
    <p><b style="color: #00ffff;">[10:17] Sector Lead (Marcus):</b> Perfect! That worked. Here is the override code he left behind: <span style="color: #00ff00; font-weight: bold;">7492-USE</span></p>
  </div>
](else:)[
  |chatExchange>[
    <b>Who do you tell Marcus?</b><br><br>
    * (link: "Reply: 'CHENG LIANG'")[
        (set: $hasOverrideCode to true)
        (replace: ?chatExchange)[
          <div style="border: 1px solid #444; padding: 10px; background-color: #111; font-family: monospace;">
            <p><b style="color: #55ff55;">[10:16] $playerName:</b> It was CHENG LIANG.</p>
            <p><b style="color: #00ffff;">[10:17] Sector Lead (Marcus):</b> Perfect! That worked. Here is the override code he left behind: <span style="color: #00ff00; font-weight: bold;">7492-USE</span></p>
          </div>
        ]
      ]
    * (link: "Reply: 'SARAH VANCE'")[
        (replace: ?chatExchange)[
          <div style="border: 1px solid #444; padding: 10px; background-color: #111; font-family: monospace;">
            <p><b style="color: #55ff55;">[10:16] $playerName:</b> I think it was SARAH VANCE.</p>
            <p><b style="color: #00ffff;">[10:17] Sector Lead (Marcus):</b> No, Vance was in Communications. That name didn't work for the systems archive key.</p>
          </div>
        ]
      ]
  ]
]

