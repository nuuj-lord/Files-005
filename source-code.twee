:: Talk To Receptionist {"position":"850,550","size":"100,100"}
{(if: (datatype: $playerName) is not string)[
  (set: $playerName to (string: $playerName))
]}

(if: $talkedToDeskGuy2 is true)[
  (if: $playerName is "" or $playerName is "0")[
    (set: $playerName to "Recruit")
  ]

  You: "Can I see the manager?"

  Receptionist: "Sure, just wait a few seconds!"

  ''10 SECONDS LATER''

  Manager: "Right, what do you want?"

  * [[Ask about facility security|Manager Security]]
  * [[Ask where your desk is|Manager Desk]]
  * [[Say you're lost|Manager Lost]]
](else:)[
  You: "Erm hi! I just got a new job here and I have no idea where I'm supposed to be right now."

  Receptionist: "New recruit? I'll print up your ID card real quick! Just, what's your name again?"

  (input: bind $playerName, "")

  <br><br>

  |msg>[]

  <br>

  |submitLink>[
    (link: "Hand over your details")[
      (set: $playerName to (string: $playerName))
      (if: $playerName is "" or $playerName is " ")[
        (replace: ?msg)[<span style="color: #ff5555;">Receptionist: "I'll need an actual name for the badge!"</span>]
        (rerun: ?submitLink)
      ](else:)[
        (goto: "Scene 2")
      ]
    ]
  ]
]


