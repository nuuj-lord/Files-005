:: Loading {"position":"975,0","size":"100,100"}
{(set: $inventory to (a:))
(set: $killCount to 0)
(set: $animalKills to 0)
(set: $spiderKilled to false)}

<pre>
===================================================================
 LOADING...
===================================================================
</pre>

|loader>[[░░░░░░░░░░] 0%]

{(set: $progress to 0)
(live: 0.5s)[
  (set: $progress to $progress + 10)
  (if: $progress is 10)[
    (replace: ?loader)[[█░░░░░░░░░] 10%]
  ](else-if: $progress is 20)[
    (replace: ?loader)[[██░░░░░░░░] 20%]
  ](else-if: $progress is 30)[
    (replace: ?loader)[[███░░░░░░░] 30%]
  ](else-if: $progress is 40)[
    (replace: ?loader)[[████░░░░░░] 40%]
  ](else-if: $progress is 50)[
    (replace: ?loader)[[█████░░░░░] 50%]
  ](else-if: $progress is 60)[
    (replace: ?loader)[[██████░░░░] 60%]
  ](else-if: $progress is 70)[
    (replace: ?loader)[[███████░░░] 70%]
  ](else-if: $progress is 80)[
    (replace: ?loader)[[████████░░] 80%]
  ](else-if: $progress is 90)[
    (replace: ?loader)[[█████████░] 90%]
  ](else-if: $progress >= 100)[
    (replace: ?loader)[[██████████] 100% COMPLETE]
    (stop:)
  ]
]}

(after: 5s)[(goto: "Enter?")]


