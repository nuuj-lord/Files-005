<h3>DOOR ACCESS PANEL - SEQUENTIAL KEYPAD</h3>
<p>Watch the pattern and repeat it back by clicking the colored buttons!</p>

<div style="text-align: center;">
  <div id="simon-status" style="color: #ffff00; font-weight: bold; font-family: monospace; margin-bottom: 15px;">Press Start to Begin</div>
  
  <table style="margin: 0 auto; border-collapse: collapse; border: none;">
    <tr>
      <td style="padding: 5px; border: none;">
        <button id="btn-0" style="width: 90px; height: 90px; background-color: #880000; border: 2px solid #fff; border-radius: 8px; cursor: pointer;"></button>
      </td>
      <td style="padding: 5px; border: none;">
        <button id="btn-1" style="width: 90px; height: 90px; background-color: #008800; border: 2px solid #fff; border-radius: 8px; cursor: pointer;"></button>
      </td>
    </tr>
    <tr>
      <td style="padding: 5px; border: none;">
        <button id="btn-2" style="width: 90px; height: 90px; background-color: #000088; border: 2px solid #fff; border-radius: 8px; cursor: pointer;"></button>
      </td>
      <td style="padding: 5px; border: none;">
        <button id="btn-3" style="width: 90px; height: 90px; background-color: #888800; border: 2px solid #fff; border-radius: 8px; cursor: pointer;"></button>
      </td>
    </tr>
  </table>

  <br>
  <button id="start-btn" style="padding: 10px 20px; font-weight: bold; cursor: pointer;">START SYSTEM</button>
</div>

<br>

<div id="win-link-container" style="display: none; text-align: center; font-size: 1.2em;">
  <span style="color: #00ff00; font-weight: bold;">*CLICK* System Override Accepted!</span><br><br>
  (link: "Return to Door")[(set: $doorUnlocked to true)(goto: "maze7")]
</div>

<br><br>

<div style="text-align: center;">
  [[Step Back|maze7]]
</div>

<script>
(function() {
  const colors = [
    { base: '#880000', active: '#ff0000' },
    { base: '#008800', active: '#00ff00' },
    { base: '#000088', active: '#0088ff' },
    { base: '#888800', active: '#ffff00' }
  ];

  let sequence = [];
  let playerStep = 0;
  let isPlayingSequence = false;
  let isProcessingClick = false;
  let gameWon = false;
  const targetRounds = 7; 

  const status = document.getElementById('simon-status');
  const startBtn = document.getElementById('start-btn');
  const winLink = document.getElementById('win-link-container');
  const buttons = [
    document.getElementById('btn-0'),
    document.getElementById('btn-1'),
    document.getElementById('btn-2'),
    document.getElementById('btn-3')
  ];

  function flashButton(index, duration = 250) {
    return new Promise(resolve => {
      buttons[index].style.backgroundColor = colors[index].active;
      buttons[index].style.boxShadow = `0 0 15px ${colors[index].active}`;
      setTimeout(() => {
        buttons[index].style.backgroundColor = colors[index].base;
        buttons[index].style.boxShadow = 'none';
        setTimeout(resolve, 100);
      }, duration);
    });
  }

  async function playSequence() {
    isPlayingSequence = true;
    status.innerText = "Observe Sequence...";
    playerStep = 0;

    for (let i = 0; i < sequence.length; i++) {
      await flashButton(sequence[i], 350);
    }

    isPlayingSequence = false;
    status.innerText = `Your turn! (${sequence.length}/${targetRounds})`;
  }

  function nextRound() {
    sequence.push(Math.floor(Math.random() * 4));
    playSequence();
  }

  startBtn.onclick = function() {
    startBtn.style.display = 'none';
    winLink.style.display = 'none';
    sequence = [];
    gameWon = false;
    nextRound();
  };

  buttons.forEach((btn, idx) => {
    btn.onclick = async function() {
      if (isPlayingSequence || isProcessingClick || sequence.length === 0 || gameWon) return;

      isProcessingClick = true;
      const expectedIndex = sequence[playerStep];

      await flashButton(idx, 150);

      if (idx === expectedIndex) {
        playerStep++;
        if (playerStep === sequence.length) {
          if (sequence.length === targetRounds) {
            gameWon = true;
            
            // Set variable via Harlowe API directly
            if (window.Harlowe && window.Harlowe.variableState) {
              Harlowe.variableState.set('doorUnlocked', true);
            }
            
            status.innerHTML = "<span style='color: #00ff00; font-size: 1.2em;'>ACCESS GRANTED!</span>";
            winLink.style.display = 'block';
          } else {
            status.innerText = "Correct! Get ready...";
            setTimeout(nextRound, 800);
          }
        }
      } else {
        status.innerHTML = "<span style='color: #ff5555;'>ACCESS DENIED! TRY AGAIN</span>";
        startBtn.style.display = 'inline-block';
        startBtn.innerText = 'RETRY';
        sequence = [];
      }

      isProcessingClick = false;
    };
  });
})();
</script>


