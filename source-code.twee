:: Exit? {"position":"425,0","size":"100,100"}
<div id="exit-message" style="margin-top: 10px;"></div>

(link: "Exit Game")[
  <script>
    window.close();
    
    // If the window is still open after trying to close it, show text directly on the page
    setTimeout(function() {
      if (!window.closed) {
        document.getElementById('exit-message').innerHTML = '<span style="color: #ff5555; font-weight: bold;">Due to an error this has not closed. Please do this manualy.</span>';
      }
    }, 200);
  </script>
]


